// This file defines our entire database structure.
// Prisma reads this to generate a type-safe client, and to create/update
// the actual tables in Postgres via migrations.

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Enums ---

// Restricting roles to exactly these two values at the database level
// (not just in application code) means it's impossible to ever insert
// a User with an invalid role, no matter what code path creates one.
enum Role {
  ADMIN
  OFFICER
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

// --- Models ---

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String // stored as a bcrypt hash, never plain text
  role      Role     @default(OFFICER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdEvents        Event[]
  createdAnnouncements Announcement[]
  auditLogs             AuditLog[]
  uploadedImages       GalleryImage[]
  reviewedApplications MembershipApplication[]

  @@map("users")
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String
  location    String?
  startsAt    DateTime
  endsAt      DateTime?

  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startsAt])
  @@map("events")
}

model Announcement {
  id      String @id @default(cuid())
  title   String
  body    String

  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("announcements")
}

// A generic activity log — not tied to one specific feature. Any part of
// the app can write an entry here (we're starting with Announcements,
// since that's what needs it right now).
model AuditLog {
  id         String @id @default(cuid())
  action     String // "CREATE" | "UPDATE" | "DELETE"
  entityType String // e.g. "Announcement"
  entityId   String
  summary    String // human-readable, e.g. the announcement's title

  // Full before/after snapshots of the changed fields, so the log can show
  // exactly what changed, not just that something changed. Nullable
  // because CREATE has no "before" and DELETE has no "after".
  previousData Json?
  newData      Json?

  performedBy     User?   @relation(fields: [performedById], references: [id], onDelete: SetNull)
  performedById   String?
  // Stored separately from the relation above so the log still reads
  // correctly ("deleted by Jane Smith") even if that account is later
  // removed — the whole point of an audit trail is that it survives
  // account deletion.
  performedByName String

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}

model GalleryImage {
  id      String  @id @default(cuid())
  url     String
  caption String?

  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById String?

  createdAt DateTime @default(now())

  @@map("gallery_images")
}

model MembershipApplication {
  id          String @id @default(cuid())
  fullName    String
  email       String
  studentId   String
  courseYear  String
  gamesPlayed String
  message     String

  status ApplicationStatus @default(PENDING)

  reviewedBy   User?     @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedById String?
  reviewedAt   DateTime?

  member Member?

  createdAt DateTime @default(now())

  @@index([status])
  @@map("membership_applications")
}

// Created automatically only when an application is approved. Deliberately
// separate from User — this is a verified-identity record for the QR
// scan-to-confirm flow, not a login account.
model Member {
  id       String       @id @default(cuid())
  fullName String
  email    String
  status   MemberStatus @default(ACTIVE)

  application   MembershipApplication @relation(fields: [applicationId], references: [id])
  applicationId String                @unique

  joinedAt DateTime @default(now())

  @@map("members")
}