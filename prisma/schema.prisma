// This file defines our entire database structure.
// Prisma reads this to generate a type-safe client, and to create/update
// the actual tables in Postgres via migrations.

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Enums ---

// Restricting roles to exactly these two values at the database level
// (not just in application code) means it's impossible to ever insert
// a User with an invalid role, no matter what code path creates one.
enum Role {
  ADMIN
  OFFICER
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

enum PaymentMethod {
  CASH
  ONLINE
}

enum HeroMediaType {
  IMAGE
  VIDEO
}

enum EventMediaType {
  IMAGE
  VIDEO
}

// --- Models ---

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String // stored as a bcrypt hash, never plain text
  role      Role     @default(OFFICER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdEvents        Event[]
  createdAnnouncements Announcement[]
  auditLogs             AuditLog[]
  uploadedImages       GalleryImage[]
  reviewedApplications MembershipApplication[]
  createdTeamMembers   TeamMember[]
  createdAlbums        Album[]

  @@map("users")
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String
  location    String?
  startsAt    DateTime
  endsAt      DateTime?
  isFeatured  Boolean   @default(false)

  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  media EventMedia[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startsAt])
  @@map("events")
}

// Promotional images/videos attached to an event. Cascade-deletes with
// the event — an event's media has no meaning once the event is gone.
model EventMedia {
  id    String         @id @default(cuid())
  url   String
  type  EventMediaType
  order Int            @default(0)

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String

  createdAt DateTime @default(now())

  @@index([eventId])
  @@map("event_media")
}

model Announcement {
  id      String @id @default(cuid())
  title   String
  body    String

  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("announcements")
}

// A generic activity log — not tied to one specific feature. Any part of
// the app can write an entry here (we're starting with Announcements,
// since that's what needs it right now).
model AuditLog {
  id         String @id @default(cuid())
  action     String // "CREATE" | "UPDATE" | "DELETE"
  entityType String // e.g. "Announcement"
  entityId   String
  summary    String // human-readable, e.g. the announcement's title

  // Full before/after snapshots of the changed fields, so the log can show
  // exactly what changed, not just that something changed. Nullable
  // because CREATE has no "before" and DELETE has no "after".
  previousData Json?
  newData      Json?

  performedBy     User?   @relation(fields: [performedById], references: [id], onDelete: SetNull)
  performedById   String?
  // Stored separately from the relation above so the log still reads
  // correctly ("deleted by Jane Smith") even if that account is later
  // removed — the whole point of an audit trail is that it survives
  // account deletion.
  performedByName String

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}

// Every image now belongs to exactly one album — Gallery is album-based,
// not a flat list, per the redesign.
model Album {
  id          String    @id @default(cuid())
  title       String
  description String?
  eventDate   DateTime?
  isFeatured  Boolean   @default(false)

  images GalleryImage[] @relation("AlbumImages")

  // Points at one of this album's own images. onDelete: SetNull means if
  // that specific image is later deleted, the album just loses its cover
  // (not an error) — it doesn't block deleting the image.
  coverImage   GalleryImage? @relation("AlbumCover", fields: [coverImageId], references: [id], onDelete: SetNull)
  coverImageId String?       @unique

  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("albums")
}

model GalleryImage {
  id      String  @id @default(cuid())
  url     String
   type    EventMediaType @default(IMAGE)
  caption String?

  album   Album  @relation("AlbumImages", fields: [albumId], references: [id], onDelete: Cascade)
  albumId String

  coverOfAlbum Album? @relation("AlbumCover")

  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById String?

  createdAt DateTime @default(now())

  @@map("gallery_images")
}

model MembershipApplication {
  id          String @id @default(cuid())
  fullName    String
  email       String
  studentId   String
  courseYear  String
  gamesPlayed String
  message     String
  idPictureUrl String?
  paymentMethod   PaymentMethod @default(CASH)
  paymentProofUrl String?

  status ApplicationStatus @default(PENDING)

  reviewedBy   User?     @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedById String?
  reviewedAt   DateTime?

  member Member?

  createdAt DateTime @default(now())

  @@index([status])
  @@map("membership_applications")
}

// Created automatically only when an application is approved. Deliberately
// separate from User — this is a verified-identity record for the QR
// scan-to-confirm flow, not a login account.
model Member {
  id       String       @id @default(cuid())
  fullName String
  email    String
  studentId  String
  courseYear String
  status   MemberStatus @default(ACTIVE)

  application   MembershipApplication @relation(fields: [applicationId], references: [id])
  applicationId String                @unique

  joinedAt DateTime @default(now())

  @@map("members")
}

// A deliberate singleton: every row we ever create defaults to the same
// id, so there's always exactly one settings record. Queries always look
// up id: "singleton" (see getSiteSettings), never anything else.
model SiteSettings {
  id           String @id @default("singleton")
  clubName     String @default("Gamers' Guild")
  contactEmail String?
  discordUrl   String?
  facebookUrl  String?
  instagramUrl String?

  // About page content — editable by Admin, powers the /about hero and
  // content sections. coreValues/gamingCommunities are stored as
  // newline-separated lists and split apart when rendered.
  aboutHeroImageUrl String?
  aboutIntro        String?
  mission           String?
  vision            String?
  coreValues        String?
  whatWeDo          String?
  whyJoinUs         String?
  gamingCommunities String?

  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// Public "About Us" roster — officers and committee members. Deliberately
// separate from User: not everyone featured here has (or needs) a login
// account, and this content should stay editable by any Admin/Officer,
// not just whoever originally created a given entry.
model TeamMember {
  id        String  @id @default(cuid())
  name      String
  position  String // e.g. "President", "Events Committee Head"
  committee String? // optional grouping, e.g. "Executive Board"
  photoUrl  String?
  bio       String?
  order     Int     @default(0) // controls display order on the public page

  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("team_members")
}

// Singleton, same pattern as SiteSettings — the editable text blocks for
// the public About page (hero image/tagline plus each section's copy).
model AboutContent {
  id                String  @id @default("singleton")
  heroImageUrl      String?
  heroTagline       String?
  whoWeAre          String?
  mission           String?
  vision            String?
  whatWeDo          String?
  gamingCommunities String?
  whyJoin           String?

  updatedAt DateTime @updatedAt

  @@map("about_content")
}

// A short list of title+description pairs rendered as cards on the About
// page. Kept as its own table (not JSON on AboutContent) so it's a real,
// orderable, individually-editable list — consistent with how every
// other "manage a list of things" feature in this app works.
model CoreValue {
  id          String @id @default(cuid())
  title       String
  description String
  order       Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("core_values")
}

// Singleton, same pattern as SiteSettings/AboutContent. Only one of
// heroImageUrl/heroVideoUrl is actually shown at a time, controlled by
// heroMediaType — both fields are kept even when unused, so switching
// back doesn't lose the previously-uploaded file.
model HomepageContent {
  id            String        @id @default("singleton")
  heroMediaType HeroMediaType @default(IMAGE)
  heroImageUrl  String?
  heroVideoUrl  String?
  heroTagline   String?

  updatedAt DateTime @updatedAt

  @@map("homepage_content")
}
