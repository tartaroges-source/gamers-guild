# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# --- Database (added in Milestone 1) ---
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

# --- Auth (added in Milestone 1) ---
# AUTH_SECRET=""       # generate with: npx auth secret
# NEXTAUTH_URL="http://localhost:3000"
# Public origin used in generated QR codes. Set this to the deployed site URL
# so a QR scanned from any device opens the member-verification page.
# NEXT_PUBLIC_APP_URL="https://pncgamersguild.vercel.app"

# --- File storage (added in Milestone 5) ---
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
